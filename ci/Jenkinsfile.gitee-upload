// Jenkins job "sayhey-gitee-upload" (Pipeline script from SCM, script path
// ci/Jenkinsfile.gitee-upload). Triggered by .github/workflows/release.yml
// after the GitHub Release exists. Downloads the release zip from GitHub and
// uploads it to the matching Gitee release (created by the workflow).
//
// Needs a Jenkins credential "gitee-token" (Secret text). No jq required.
pipeline {
    agent any

    parameters {
        string(name: 'TAG', defaultValue: '', description: 'Release tag, e.g. v1.0.2')
        string(name: 'RID', defaultValue: '', description: 'Gitee release id (numeric)')
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        GH_REPO    = 'DoerrDev/SayHey'
        GITEE_REPO = 'doerrdev/SayHey'
        ASSET      = 'sayhey-windows.zip'
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    if (!(params.TAG ==~ /^v[0-9][0-9A-Za-z._-]*$/)) {
                        error("Bad TAG: '${params.TAG}'")
                    }
                    if (!(params.RID ==~ /^[0-9]+$/)) {
                        error("Bad RID: '${params.RID}'")
                    }
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.TAG}"
                }
            }
        }

        stage('Download from GitHub') {
            steps {
                sh '''
                    set -eu
                    rm -f "$ASSET"
                    # The Release is created right before this job is triggered;
                    # retry on 404 in case of propagation delay.
                    curl -fL --retry 5 --retry-delay 10 --retry-all-errors \
                        --connect-timeout 30 --max-time 600 \
                        -o "$ASSET" \
                        "https://github.com/$GH_REPO/releases/download/$TAG/$ASSET"
                    ls -l "$ASSET"
                '''
            }
        }

        stage('Upload to Gitee') {
            steps {
                withCredentials([string(credentialsId: 'gitee-token', variable: 'GITEE_TOKEN')]) {
                    // single-quoted: the secret is expanded by the shell, never by Groovy
                    sh '''
                        # Jenkins runs sh with -e; disable it so the retry loop works
                        set +e
                        set -u
                        API="https://gitee.com/api/v5/repos/$GITEE_REPO/releases/$RID/attach_files"
                        for i in 1 2 3; do
                            rm -f upload.json
                            # abort stalled uploads (<30KB/s for 60s) instead of hanging.
                            # No Expect: 100-continue, HTTP/1.1 only; print timings to see
                            # whether the connection dies mid-upload or while waiting.
                            curl -sS --http1.1 -H 'Expect:' -o upload.json \
                                -w 'http=%{http_code} sent=%{size_upload}B connect=%{time_connect}s pretransfer=%{time_pretransfer}s total=%{time_total}s\n' \
                                --connect-timeout 30 --max-time 900 \
                                --speed-limit 30000 --speed-time 60 \
                                -X POST "$API" \
                                --form-string "access_token=$GITEE_TOKEN" \
                                -F "file=@$ASSET"
                            rc=$?
                            echo "attempt $i: curl exit $rc"
                            [ -f upload.json ] && { cat upload.json; echo; }
                            # success = curl ok and response contains the attachment (id/name)
                            if [ "$rc" -eq 0 ] && grep -q '"name"' upload.json 2>/dev/null; then
                                exit 0
                            fi
                            sleep 15
                        done
                        echo "upload failed after 3 attempts" >&2
                        exit 1
                    '''
                }
            }
        }
    }

    post {
        cleanup {
            sh 'rm -f sayhey-windows.zip upload.json'
        }
    }
}
