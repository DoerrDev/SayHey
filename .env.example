VOLC_APP_KEY=your-app-key
# 兼容旧写法：如果你之前已经在本地用 VOLC_API_KEY，也仍然可用。
# VOLC_API_KEY=your-app-key
VOLC_RESOURCE_ID=volc.service_type.10053
VOLC_WS_URL=wss://openspeech.bytedance.com/api/v4/ast/v2/translate

SOURCE_LANGUAGE=ja
TARGET_LANGUAGE=zh
MODE=s2t

# 每包时长，官方建议 80ms。
CHUNK_MS=80

# 可选：把实时字幕顺手追加到本地日志文件。
TEXT_LOG=logs/subtitles.txt

# 本地录音验证器会把收到的音频先保存成 wav，方便你先试听确认路由。
VERIFY_RECORD_DIR=recordings
AUTO_PLAY_AFTER_SAVE=1

# 可选：不填就用设备默认采样率与声道。
# RECORD_SAMPLE_RATE=44100
# RECORD_CHANNELS=2

# Product route:
# Real mic -> App -> CABLE Input -> CABLE Output -> target app.
# Run `python list_audio_devices.py` to find your microphone index.
# MIC_INPUT_INDEX=8
VB_CABLE_INPUT_NAME=CABLE Input
VB_CABLE_OUTPUT_NAME=CABLE Output
VB_CABLE_OUTPUT_CHANNELS=2
RECORD_TRANSLATED_WAV=1

# 第三方同声传译音频 demo。
S2S_SOURCE_LANGUAGE=en
S2S_TARGET_LANGUAGE=zh
S2S_RECORD_DIR=recordings_s2s
# S2S_SPEAKER_ID=
S2S_SPEECH_RATE=0
# Engine options: huoshan, mock.
TRANSLATOR_ENGINE=huoshan
# S2S_SAMPLE_RATE=24000

# Game/system audio subtitles:
# Captures current Windows speaker/headphone output via WASAPI loopback.
GAME_SUBTITLE_ENABLED=0
GAME_SUBTITLE_ENGINE=huoshan_s2t
GAME_SUBTITLE_SOURCE_LANGUAGE=en
GAME_SUBTITLE_TARGET_LANGUAGE=zh
# Optional: partial match of the Windows output device name. Empty = default speaker.
GAME_AUDIO_DEVICE_NAME=
GAME_SUBTITLE_CHUNK_MS=80
